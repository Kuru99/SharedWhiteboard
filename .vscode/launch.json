{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug Backend (Go)",
      "type": "go",
      "request": "launch",
      "mode": "debug",
      "program": "${workspaceFolder}/backend/main.go",
      "cwd": "${workspaceFolder}/backend"
    },
    {
      "name": "Debug Frontend (Chrome)",
      "type": "chrome",
      "request": "launch",
      "url": "http://localhost:5173",
      "webRoot": "${workspaceFolder}/frontend/src",
      "sourceMapPathOverrides": {
        "webpack:///./~/*": "${webRoot}/node_modules/*",
        "webpack:///src/*": "${webRoot}/*",
        "webpack:///*": "*"
      }
    }
  ],
  "compounds": [
    {
      "name": "Debug Both (Backend & Frontend)",
      "configurations": [
        "Debug Backend (Go)",
        "Debug Frontend (Chrome)"
      ]
    }
  ]
}

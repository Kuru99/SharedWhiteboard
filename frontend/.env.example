# GitHub Pages / local build で使うバックエンド URL
# Render などで公開したバックエンドのURLを指定します
VITE_API_BASE_URL=https://shared-whiteboard-backend.onrender.com
VITE_WS_BASE_URL=wss://shared-whiteboard-backend.onrender.com

# GitHub Pages project page で公開する場合はベース URL を指定します
# 例: リポジトリが kuru99/SharedWhiteboard の場合は /SharedWhiteboard/
VITE_BASE_URL=/SharedWhiteboard/
